{
  "name": "trvkc-prop-challenge-simulator-jev",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "vars": {
    "ALLOWED_ORIGINS": "https://0xtrvkc.github.io",
    "JEV_MODEL": "jev-latest"
  },
  "ratelimits": [
    {
      "name": "JEV_LIMITER",
      "namespace_id": "260044",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
